# Linux/systemd example. Adjust paths and the service user for your home server.
[Unit]
Description=Crosscheck static website origin
After=network.target

[Service]
Type=simple
User=caddy
Group=caddy
Environment=CROSSCHECK_SITE_ROOT=/srv/crosscheck/site
Environment=XDG_CONFIG_HOME=/var/lib/crosscheck-site/config
Environment=XDG_DATA_HOME=/var/lib/crosscheck-site/data
StateDirectory=crosscheck-site
StateDirectoryMode=0700
ExecStart=/usr/bin/caddy run --config /srv/crosscheck/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
